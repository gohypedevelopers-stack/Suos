# Application
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL
POSTGRES_DB=suos
POSTGRES_USER=suos
POSTGRES_PASSWORD=replace-with-a-long-database-password
# Use `postgres` as the hostname in Docker Compose. Use `localhost` when the
# application runs directly on the host.
DATABASE_URL=postgresql://suos:replace-with-a-long-database-password@postgres:5432/suos

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=suos-media
R2_PUBLIC_URL=https://cdn.example.com

# Used only by `npm run admin:promote`
ADMIN_EMAIL=

# ── Public site ───────────────────────────────────────────────────────────────
# Used for links in emails, sitemap.xml and robots.txt. Defaults to BETTER_AUTH_URL.
NEXT_PUBLIC_SITE_URL=https://suosindia.com
STORE_NAME=SUOS
STORE_SUPPORT_EMAIL=info@suos.in

# ── Email notifications ───────────────────────────────────────────────────────
# Sender shown to customers. Required for any email to go out.
EMAIL_FROM="SUOS <orders@suosindia.com>"
EMAIL_REPLY_TO=info@suos.in
# Where new-order and contact-form alerts are sent.
ADMIN_NOTIFICATION_EMAIL=
# Option A: Resend (https://resend.com) – simplest, domain must be verified.
RESEND_API_KEY=
# Option B: any SMTP account (Google Workspace, Zoho, Hostinger…). Leave RESEND_API_KEY empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ── WhatsApp notifications (Meta WhatsApp Cloud API) ──────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# Number that receives new-order alerts, e.g. 919876543210
WHATSAPP_ADMIN_NUMBER=
# Approved template names. Each template body uses {{1}} name, {{2}} order number, {{3}} total, {{4}} link.
WHATSAPP_TEMPLATE_ORDER_PLACED=
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=
WHATSAPP_TEMPLATE_ORDER_FULFILLED=
WHATSAPP_TEMPLATE_ORDER_CANCELLED=
WHATSAPP_TEMPLATE_ADMIN_ALERT=

# ── Session recordings & analytics retention ──────────────────────────────────
# Percentage of storefront visits to record with rrweb (0–100).
NEXT_PUBLIC_RECORDING_SAMPLE_RATE=100
# Shared secret for the daily retention job: POST /api/maintenance/cleanup
MAINTENANCE_SECRET=
RECORDING_RETENTION_DAYS=30
ANALYTICS_RETENTION_DAYS=180

# ── Google sign-in (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Staff roles ───────────────────────────────────────────────────────────────
# Used only by `npm run admin:promote`: ADMIN (full), SUB_ADMIN (permissions below), CUSTOMER (revoke).
# The dashboard page "Staff & permissions" does the same with a UI.
ADMIN_ROLE=ADMIN
# Comma-separated, SUB_ADMIN only. See lib/permissions.ts for the full list,
# e.g. orders.view,orders.manage,products.view,products.manage,inventory.manage
ADMIN_PERMISSIONS=
