generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SUB_ADMIN
  ADMIN
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  BEGIN_CHECKOUT
  PURCHASE
  SEARCH
  CLICK
  SCROLL
  MOVE
  CUSTOM
}

enum ContactMessageStatus {
  NEW
  READ
  RESOLVED
}

enum CategoryStatus {
  DRAFT
  ACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum DraftOrderStatus {
  DRAFT
  SENT
  COMPLETED
}

enum DiscountType {
  PRODUCT
  ORDER
  BUY_X_GET_Y
  FREE_SHIPPING
}

enum DiscountMethod {
  CODE
  AUTOMATIC
}

enum DiscountStatus {
  ACTIVE
  INACTIVE
}

enum DiscountValueType {
  PERCENTAGE
  FIXED
  FREE
}

enum DiscountAppliesTo {
  ALL
  PRODUCTS
  COLLECTIONS
}

enum BannerPlacement {
  HERO
  MIDDLE
  BOTTOM
  EDITORIAL
  DENIM_CAROUSEL
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  emailMarketingSubscribed Boolean @default(false)
  whatsappMarketingSubscribed Boolean @default(false)
  phone         String?
  image         String?
  role          Role      @default(CUSTOMER)
  permissions   String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  cart          Cart?
  orders        Order[]
  draftOrders   DraftOrder[]
  notifications Notification[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Category {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  description    String?
  status         CategoryStatus @default(DRAFT)
  visible        Boolean        @default(true)
  imageObjectKey String?
  imageAltText   String?
  parentId       String?
  parent         Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]     @relation("CategoryHierarchy")
  products       Product[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([parentId])
  @@index([status, visible])
  @@map("categories")
}

model Product {
  id          String                  @id @default(cuid())
  title       String
  slug        String                  @unique
  description String?
  vendor      String                  @default("SUOS")
  status      ProductStatus           @default(DRAFT)
  categoryId  String?
  tags        String[]                @default([])
  details     Json?
  taxRate     Decimal?                @default(12.00) @db.Decimal(5, 2)
  hsnCode     String?                 @default("6203")
  isTaxExempt Boolean                 @default(false)
  category    Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants    ProductVariant[]
  images      ProductImage[]
  collections ProductsOnCollections[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([status])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id                String      @id @default(cuid())
  productId         String
  title             String      @default("Default")
  sku               String      @unique
  price             Decimal     @db.Decimal(12, 2)
  compareAtPrice    Decimal?    @db.Decimal(12, 2)
  inventoryQuantity Int         @default(0)
  optionValues      Json?
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  draftOrderItems   DraftOrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  objectKey String   @unique
  altText   String?
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, position])
  @@map("product_images")
}

model Collection {
  id             String                  @id @default(cuid())
  title          String
  slug           String                  @unique
  description    String?
  isPublished    Boolean                 @default(false)
  imageObjectKey String?
  imageAltText   String?
  products       ProductsOnCollections[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@map("collections")
}

model ProductsOnCollections {
  productId    String
  collectionId String
  position     Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
  @@map("products_on_collections")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int            @default(1)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(cuid())
  number          Int         @unique @default(autoincrement())
  userId          String?
  email           String
  status          OrderStatus @default(PENDING)
  currency        String      @default("INR")
  subtotal        Decimal     @db.Decimal(12, 2)
  discount        Decimal     @default(0) @db.Decimal(12, 2)
  shipping        Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  tax             Decimal     @default(0) @db.Decimal(12, 2)
  cgst            Decimal     @default(0) @db.Decimal(12, 2)
  sgst            Decimal     @default(0) @db.Decimal(12, 2)
  igst            Decimal     @default(0) @db.Decimal(12, 2)
  taxDetails      Json?
  shippingAddress Json?
  phone           String?
  paymentMethod   String?
  shippingMethod  String?
  discountCode    String?
  customerNote    String?
  source          String      @default("ADMIN")
  analyticsSessionId String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  notifications   Notification[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@index([email])
  @@map("orders")
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  variantId String?
  title     String
  sku       String
  quantity  Int
  unitPrice Decimal         @db.Decimal(12, 2)
  total     Decimal         @db.Decimal(12, 2)
  taxRate   Decimal?        @default(12.00) @db.Decimal(5, 2)
  tax       Decimal?        @default(0) @db.Decimal(12, 2)
  hsnCode   String?         @default("6203")
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model DraftOrder {
  id        String           @id @default(cuid())
  number    Int              @unique @default(autoincrement())
  userId    String?
  email     String
  status    DraftOrderStatus @default(DRAFT)
  currency  String           @default("INR")
  subtotal  Decimal          @db.Decimal(12, 2)
  discount  Decimal          @default(0) @db.Decimal(12, 2)
  shipping  Decimal          @default(0) @db.Decimal(12, 2)
  total     Decimal          @db.Decimal(12, 2)
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  items     DraftOrderItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@map("draft_orders")
}

model DraftOrderItem {
  id           String          @id @default(cuid())
  draftOrderId String
  variantId    String?
  title        String
  sku          String
  quantity     Int
  unitPrice    Decimal         @db.Decimal(12, 2)
  total        Decimal         @db.Decimal(12, 2)
  draftOrder   DraftOrder      @relation(fields: [draftOrderId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([draftOrderId])
  @@index([variantId])
  @@map("draft_order_items")
}

model Discount {
  id                 String              @id @default(cuid())
  title              String
  code               String?             @unique
  type               DiscountType
  method             DiscountMethod
  status             DiscountStatus      @default(ACTIVE)
  valueType          DiscountValueType
  value              Decimal?            @db.Decimal(12, 2)
  appliesTo          DiscountAppliesTo   @default(ALL)
  productIds         String[]            @default([])
  collectionIds      String[]            @default([])
  buyProductIds      String[]            @default([])
  getProductIds      String[]            @default([])
  eligibility        String              @default("ALL")
  minimumType        String              @default("NONE")
  minimumQuantity    Int?
  minimumAmount      Decimal?            @db.Decimal(12, 2)
  usageLimit         Int?
  onePerCustomer     Boolean             @default(false)
  usageCount         Int                 @default(0)
  startsAt           DateTime            @default(now())
  endsAt             DateTime?
  config             Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status, startsAt])
  @@index([type, status])
  @@map("discounts")
}

model Banner {
  id              String          @id @default(cuid())
  title           String?
  subtitle        String?
  desktopImageKey String
  mobileImageKey  String?
  ctaText         String?
  ctaLink         String?
  placement       BannerPlacement @default(HERO)
  textAlignment   String          @default("CENTER")
  overlayOpacity  Int             @default(20)
  isActive        Boolean         @default(true)
  position        Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([placement, isActive, position])
  @@map("banners")
}

model TaxSetting {
  id             String   @id @default("default")
  originState    String   @default("Delhi")
  gstin          String   @default("")
  defaultGstRate Decimal  @default(12.00) @db.Decimal(5, 2)
  priceInclusive Boolean  @default(true)
  defaultHsn     String   @default("6203")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("tax_settings")
}

model Notification {
  id         String              @id @default(cuid())
  channel    NotificationChannel
  template   String
  recipient  String
  subject    String?
  status     NotificationStatus  @default(PENDING)
  error      String?
  providerId String?
  payload    Json?
  orderId    String?
  userId     String?
  order      Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime            @default(now())
  sentAt     DateTime?

  @@index([orderId])
  @@index([userId])
  @@index([status, createdAt])
  @@index([channel, createdAt])
  @@map("notifications")
}

model AnalyticsSession {
  id          String           @id
  visitorId   String
  userId      String?
  landingPath String
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  /** Normalised traffic channel: instagram, facebook, whatsapp, google, google-ads, direct, referral… */
  channel     String           @default("direct")
  /** Raw source behind the channel, e.g. the referring host or utm_source. */
  source      String?
  medium      String?
  fbclid      String?
  gclid       String?
  userAgent   String?
  device      String           @default("desktop")
  country     String?
  pageViews   Int              @default(0)
  converted   Boolean          @default(false)
  orderId     String?
  recorded    Boolean          @default(false)
  startedAt   DateTime         @default(now())
  lastSeenAt  DateTime         @default(now())
  events      AnalyticsEvent[]

  @@index([startedAt])
  @@index([visitorId])
  @@index([userId])
  @@index([device, startedAt])
  @@index([channel, startedAt])
  @@map("analytics_sessions")
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  sessionId String
  type      AnalyticsEventType
  path      String
  name      String?
  payload   Json?
  session   AnalyticsSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@index([sessionId, createdAt])
  @@index([type, createdAt])
  @@index([path, createdAt])
  @@map("analytics_events")
}

model SearchLog {
  id          String   @id @default(cuid())
  query       String
  normalized  String
  resultCount Int
  suggestion  String?
  sessionId   String?
  createdAt   DateTime @default(now())

  @@index([normalized, createdAt])
  @@index([createdAt])
  @@map("search_logs")
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
  @@map("contact_messages")
}

/// One rrweb recording per storefront analytics session. Chunks hold the
/// gzip-compressed event batches in order.
model SessionRecording {
  id          String                  @id
  visitorId   String
  userId      String?
  device      String                  @default("desktop")
  userAgent   String?
  country     String?
  firstPath   String
  pagePaths   String[]                @default([])
  startedAt   DateTime                @default(now())
  lastEventAt DateTime                @default(now())
  durationMs  Int                     @default(0)
  eventCount  Int                     @default(0)
  chunkCount  Int                     @default(0)
  byteSize    Int                     @default(0)
  converted   Boolean                 @default(false)
  orderId     String?
  chunks      SessionRecordingChunk[]

  @@index([startedAt])
  @@index([device, startedAt])
  @@index([converted, startedAt])
  @@index([visitorId])
  @@map("session_recordings")
}

model SessionRecordingChunk {
  id          String           @id @default(cuid())
  recordingId String
  seq         Int
  data        Bytes
  eventCount  Int
  byteSize    Int
  createdAt   DateTime         @default(now())
  recording   SessionRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@unique([recordingId, seq])
  @@map("session_recording_chunks")
}

/// Editable storefront content (announcements, launch offer, lookbook, edits,
/// contact details, FAQs, policies). Keyed by section; the value shape per
/// key is defined in lib/site-content.ts and defaults live in code.
model SiteContent {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("site_content")
}


